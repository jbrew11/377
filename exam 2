# "Using BWGHT, regress bwght on cigs and faminc"  ->  lm(Y ~ X's, data = DATASET)
reg <- lm(bwght ~ cigs + faminc, data = bwght)                 # TYPE: Y ~ X's, data = DATASET
d   <- model.frame(reg)                                        # just run
reg$df.residual                                                # "degrees of freedom"
summary(reg)$sigma                                             # "sigma-hat" / "residual standard error"
SST <- sum((d$cigs - mean(d$cigs))^2); SST                     # "SST of cigs"        TYPE: X twice
R2  <- summary(lm(cigs ~ faminc, data = d))$r.squared; R2      # "regress cigs on the other X's, R2"   TYPE: X ~ other X's
summary(reg)$sigma / sqrt(SST * (1 - R2))                      # "se by hand"         just run
summary(reg)                                                   # "se from R": X's row, Std. Error column
# only ONE X?  skip the R2 line, use:  summary(reg)$sigma / sqrt(SST)
# column names?  names(bwght)

